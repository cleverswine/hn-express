# Copy this file to .env and adjust as needed. All values have sane defaults
# in code, so .env only needs to contain what you want to override.

# Web server
PORT=3000

# Shared
# DB_PATH defaults to $HOME/.config/hn/data/hn.sqlite3 — under Docker Compose
# that's bind-mounted from the same host path (see docker-compose.yml), so
# dev mode and Docker share one file without any config needed. Only set
# this if you want the file somewhere else entirely; note it won't expand
# $HOME or other shell variables — use a literal absolute path.
# DB_PATH=/absolute/path/to/hn.sqlite3
HN_FRONTPAGE_SIZE=30

# Worker: HN polling
FETCH_INTERVAL_MS=900000
FETCH_TIMEOUT_MS=10000

# Worker: article extraction
PLAYWRIGHT_TIMEOUT_MS=20000
IMAGE_FETCH_TIMEOUT_MS=10000

# Worker: summarization
SUMMARY_BATCH_SIZE=5
SUMMARY_CONCURRENCY=2
SUMMARY_IDLE_SLEEP_MS=15000
# Summarization (the only thing that calls Ollama) only runs during these
# local hours — outside this window the worker sleeps until it reopens.
# Fetching from HN is unaffected and keeps running on its own interval.
# Hours are 0-23, local time per TZ below. Set both to the same value to
# disable the window (summarize around the clock).
ACTIVE_HOURS_START=7
ACTIVE_HOURS_END=23

# Worker: cleanup — periodically purges stories (no longer on the front
# page) first seen more than CLEANUP_MAX_AGE_DAYS ago, on a
# CLEANUP_INTERVAL_MS cadence.
CLEANUP_INTERVAL_MS=86400000
CLEANUP_MAX_AGE_DAYS=14

# Shared: local time zone, used for the active-hours window above (and any
# timestamps). Defaults to UTC in Docker unless set — the host and worker
# should use the same TZ, so set this once here rather than per-service.
TZ=America/Chicago

# Worker: Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=300000
