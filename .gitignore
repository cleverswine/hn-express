# Dependencies
node_modules/

# SQLite database (generated at runtime by the worker/db package; lives at
# $HOME/.config/hn/data by default — see db/index.js — not under the repo,
# but this is kept in case DB_PATH is ever pointed back into the repo)
db/data/

# Environment overrides (.env.example is the tracked template)
.env
.env.local
.env.*.local

# Logs
*.log

# Claude Code local settings (machine-specific permissions, not shared)
.claude/settings.local.json

# Editor / OS cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test/coverage output, if tests get added later
coverage/
