# Copy this file to .env and adjust as needed. All values have sane defaults
# in code, so .env only needs to contain what you want to override.

# Web server
PORT=3000

# Shared
# DB_PATH defaults to $HOME/.config/hn/data/hn.sqlite3 — under Docker Compose
# that's bind-mounted from the same host path (see docker-compose.yml), so
# dev mode and Docker share one file without any config needed. Only set
# this if you want the file somewhere else entirely; note it won't expand
# $HOME or other shell variables — use a literal absolute path.
# DB_PATH=/absolute/path/to/hn.sqlite3
HN_FRONTPAGE_SIZE=30

# Worker: HN polling
FETCH_INTERVAL_MS=900000
FETCH_TIMEOUT_MS=10000

# Worker: article extraction
PLAYWRIGHT_TIMEOUT_MS=20000
IMAGE_FETCH_TIMEOUT_MS=10000

# Worker: summarization
SUMMARY_BATCH_SIZE=5
SUMMARY_CONCURRENCY=2
SUMMARY_IDLE_SLEEP_MS=15000

# Worker: Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL= llama3.2:3b
OLLAMA_TIMEOUT_MS=300000
